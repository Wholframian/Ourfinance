# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API). Usa SOLO la clave publishable/anon.
# NUNCA pongas aquí la service_role key: todo lo que empieza por VITE_ acaba en el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
